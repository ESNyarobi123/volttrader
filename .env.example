# ==========================================================================
# Volt Trades — Environment Variables (example)
# Copy to `.env` at repo root and fill in real values. NEVER commit `.env`.
# ==========================================================================

# ---- Shared ----
NODE_ENV=development

# ---- Database (PostgreSQL) ----
POSTGRES_USER=volt
POSTGRES_PASSWORD=volt_dev_password
POSTGRES_DB=volt_trades
POSTGRES_PORT=5432
DATABASE_URL="postgresql://volt:volt_dev_password@localhost:5432/volt_trades?schema=public"

# ---- Redis (optional in MVP; used later for jobs/queues) ----
# Host port (container stays 6379). Use 6380 if another Redis already owns 6379.
REDIS_PORT=6380
REDIS_URL="redis://localhost:6380"

# ---- API (NestJS + Fastify) ----
API_PORT=4000
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=api
CORS_ORIGINS="http://localhost:3001,http://localhost:3000"
# Trust X-Forwarded-* headers (only behind a reverse proxy that rewrites them).
TRUST_PROXY=false

# ---- Auth / JWT ----
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_REFRESH_TTL=1209600     # seconds (14 days)
BCRYPT_SALT_ROUNDS=12

# ---- Object Storage (S3-compatible: R2 / Spaces / MinIO / S3) ----
S3_ENDPOINT="http://localhost:9000"
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio_dev_password
S3_BUCKET=volt-trades
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL="http://localhost:9000/volt-trades"

# ---- Payments (gateway-agnostic abstraction) ----
# Active gateway driver: mock | flutterwave | pesapal | stripe | manual
PAYMENT_DEFAULT_GATEWAY=mock
PAYMENT_WEBHOOK_SECRET=change_me_webhook_signing_secret
# Dev helper for authenticated mock checkout simulate. Forced false in production.
ALLOW_MOCK_PAYMENTS=true
# UI flag for simulate buttons on checkout return (never enable in production builds).
NEXT_PUBLIC_ALLOW_MOCK_PAYMENTS=true
DEFAULT_CURRENCY=TZS

# ---- Email / SMS (providers wired later) ----
MAIL_FROM="Volt Trades <no-reply@volttrades.local>"
SMTP_URL="smtp://localhost:1025"

# ---- Web (Next.js) ----
# Use 3001 when another app already binds 3000.
WEB_PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
NEXT_PUBLIC_BRAND_NAME="Volt Trades"

# ---- Compliance flags ----
# When false, API rejects new investments (compliance gate). Projected values are never guarantees.
# Keep false in production until legal/compliance review.
FEATURE_REAL_MONEY_INVESTMENTS=false
