# Production env for docker-compose.prod.yml — copy to .env.prod on the server.
# NEVER commit .env.prod.

WEB_DOMAIN=mandandaspace.com
API_DOMAIN=api.mandandaspace.com

POSTGRES_USER=volt
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=volt_trades

JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
BCRYPT_SALT_ROUNDS=12

S3_ACCESS_KEY_ID=voltminio
S3_SECRET_ACCESS_KEY=CHANGE_ME_STRONG_MINIO_PASSWORD
S3_BUCKET=volt-trades
S3_REGION=us-east-1
S3_PUBLIC_URL=https://mandandaspace.com/media/volt-trades

CORS_ORIGINS=https://mandandaspace.com
SITE_URL=https://mandandaspace.com
NEXT_PUBLIC_API_URL=https://api.mandandaspace.com/api
NEXT_PUBLIC_SITE_URL=https://mandandaspace.com
NEXT_PUBLIC_BRAND_NAME=Volt Trades
NEXT_PUBLIC_ALLOW_MOCK_PAYMENTS=false

# Production forbids mock — use manual (bank/MM) or flutterwave when keys are set.
PAYMENT_DEFAULT_GATEWAY=manual
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
ALLOW_MOCK_PAYMENTS=false
DEFAULT_CURRENCY=USD

MAIL_FROM=Volt Trades <no-reply@mandandaspace.com>
SMTP_URL=

FEATURE_REAL_MONEY_INVESTMENTS=false
SEED_ON_BOOT=true
